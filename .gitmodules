[submodule "common/serializers/third_party/msg_codec/protobuf-c"]
	path = common/serializers/third_party/msg_codec/protobuf-c
	url = https://github.com/protobuf-c/protobuf-c.git
[submodule "tools/vendor/esp-idf-kconfig"]
	path = tools/vendor/esp-idf-kconfig
	url = https://github.com/espressif/esp-idf-kconfig.git
[submodule "port/idf_components/esp_wifi_remote/esp_wifi_remote"]
	path = port/idf_components/esp_wifi_remote/esp_wifi_remote
	url = https://github.com/espressif/esp-wifi-remote
[submodule "third_party/stm32cube/STM32CubeF4"]
	path = third_party/stm32cube/STM32CubeF4
	url = https://github.com/STMicroelectronics/STM32CubeF4.git
[submodule "third_party/freertos/FreeRTOS-Kernel"]
    path = third_party/freertos/FreeRTOS-Kernel
    url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git